rules_version = '2';

// Pacta v1 güvenlik kuralları.
// Testler: firestore-tests/ (npm run emulator:test)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function tokenEmail() {
      return request.auth.token.get('email', '');
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // Profil yalnızca sahibine açıktır. E-posta giriş kimliğidir; değiştirilemez.
    // Diğer kullanıcılar yalnızca publicProfiles üzerinden adı görür.
    // pactaCode sunucuda üretilir (codes/{kod} ile eşleşir); istemci yazamaz.
    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow create: if isSelf(uid)
        && (!('email' in request.resource.data) || request.resource.data.email == tokenEmail())
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
        && !('pactaCode' in request.resource.data);
      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['uid', 'email', 'pactaCode']);
      allow delete: if false;

      match /savedContacts/{contactId} {
        allow read, write: if isSelf(uid);
      }

      // v2: onay bekleyenler ve bildirimler Cloud Functions tarafından yazılır.
      match /inbox/{itemId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        allow update: if isSelf(uid)
          && onlyChanges(['isRead'])
          && request.resource.data.isRead is bool;
        allow create, delete: if false;
      }
    }

    match /publicProfiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['adSoyad'])
        && request.resource.data.adSoyad is string
        && request.resource.data.adSoyad.size() <= 100;
      allow delete: if false;
    }

    function isParty(data) {
      return signedIn() && request.auth.uid in data.visibleto;
    }

    // Yeni kayıt ya tek taraflı nottur ya da karşı tarafın onayını bekler.
    // Onaylı ("approved") kayıt doğrudan oluşturulamaz.
    function validNewDebt(d) {
      return d.keys().hasOnly([
          'borcluId', 'alacakliId', 'miktar', 'aciklama', 'islemTarihi',
          'tahminiOdemeTarihi', 'createdAt', 'dueReminderSent', 'status',
          'isShared', 'requiresApproval', 'visibleto', 'createdBy',
          'deletion_requester_id'])
        && d.createdBy == request.auth.uid
        && (d.borcluId == request.auth.uid || d.alacakliId == request.auth.uid)
        && d.borcluId != d.alacakliId
        && d.miktar is number && d.miktar > 0 && d.miktar <= 1000000000
        && (d.get('aciklama', null) == null
          || (d.aciklama is string && d.aciklama.size() <= 500))
        && d.islemTarihi is timestamp
        && (d.get('tahminiOdemeTarihi', null) == null
          || d.tahminiOdemeTarihi is timestamp)
        && d.createdAt == request.time
        && d.dueReminderSent == false
        && d.get('deletion_requester_id', null) == null
        && (
          (d.status == 'note'
            && d.visibleto == [request.auth.uid]
            && d.isShared == false
            && d.requiresApproval == false)
          || (d.status == 'pending'
            && d.visibleto.size() == 2
            && d.visibleto.hasAll([d.borcluId, d.alacakliId])
            && d.isShared == true
            && d.requiresApproval == true
            && userExists(d.borcluId)
            && userExists(d.alacakliId))
        );
    }

    match /debts/{debtId} {
      // Bildirimden açılan kayıt silinmiş olabilir: olmayan kayıt için izin
      // hatası yerine "yok" yanıtı döner. Var olan kaydı yalnızca taraflar okur.
      allow get: if signedIn() && (resource == null || isParty(resource.data));
      allow list: if isParty(resource.data);
      allow create: if signedIn() && validNewDebt(request.resource.data);

      allow update: if isParty(resource.data) && (
        // Bekleyen kaydı yalnızca karşı taraf onaylar veya reddeder.
        (resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && resource.data.createdBy != request.auth.uid
          && request.resource.data.updatedById == request.auth.uid
          && onlyChanges(['status', 'updatedById']))
        // Taraflardan biri onaylı kaydın silinmesini ister.
        || (resource.data.status == 'approved'
          && request.resource.data.status == 'pending_deletion'
          && request.resource.data.deletion_requester_id == request.auth.uid
          && onlyChanges(['status', 'deletion_requester_id']))
        // Silme talebini yalnızca karşı taraf reddeder.
        || (resource.data.status == 'pending_deletion'
          && resource.data.deletion_requester_id != request.auth.uid
          && request.resource.data.status == 'approved'
          && !('deletion_requester_id' in request.resource.data)
          && onlyChanges(['status', 'deletion_requester_id']))
      );

      allow delete: if isParty(resource.data) && (
        (resource.data.status == 'note' && resource.data.createdBy == request.auth.uid)
        || resource.data.status == 'rejected'
        // Silme talebini yalnızca karşı taraf onaylar.
        || (resource.data.status == 'pending_deletion'
          && resource.data.deletion_requester_id != request.auth.uid)
      );
    }

    // v2 defterler: istemci yalnızca taraf olduğu defteri okur. Tüm yazmalar
    // (kayıt, onay, itiraz, bakiye) Cloud Functions komutlarıyla yapılır.
    function isMember(data) {
      return signedIn() && request.auth.uid in data.memberUids;
    }

    match /ledgers/{ledgerId} {
      allow get: if signedIn() && (resource == null || isMember(resource.data));
      allow list: if isMember(resource.data);
      allow write: if false;

      match /entries/{entryId} {
        allow read: if isMember(resource.data);
        allow write: if false;

        match /revisions/{version} {
          allow read: if isMember(resource.data);
          allow write: if false;
        }
      }

      match /events/{eventId} {
        allow read: if isMember(resource.data);
        allow write: if false;
      }
    }

    // Hareketler ekranı: kullanıcının tüm defterlerindeki son kayıtlar
    // (collection group). Sorgu memberUids filtresi içermek zorundadır.
    match /{path=**}/entries/{entryId} {
      allow list: if isMember(resource.data);
    }

    // codes, pushQueue ve rateLimits yalnızca Cloud Functions içindir; eşleşen
    // kural olmadığı için istemciye kapalıdır.

    // Bildirimleri yalnızca Cloud Functions yazar; alıcı yalnızca okundu bilgisini değiştirir.
    match /notifications/{notificationId} {
      allow get, list: if signedIn() && resource.data.toUserId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.toUserId == request.auth.uid
        && onlyChanges(['isRead'])
        && request.resource.data.isRead is bool;
      allow create, delete: if false;
    }
  }
}
